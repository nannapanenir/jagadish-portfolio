---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import literataLatin from '@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { profile } from '../data/profile';

const canonical = new URL('/', profile.siteUrl).href;
const ogImage = new URL('/og.png', profile.siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: canonical,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.locationShort,
    addressRegion: profile.region,
    addressCountry: 'US',
  },
  worksFor: { '@type': 'Organization', name: profile.stops.find((s) => s.current)?.org },
  ...(profile.linkedin ? { sameAs: [profile.linkedin] } : {}),
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{profile.metaTitle}</title>
<meta name="description" content={profile.metaDescription}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#F6F7F5">
<link rel="preload" href={literataLatin} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin>

<meta property="og:type" content="profile">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={profile.metaTitle}>
<meta property="og:description" content={profile.metaDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${profile.name}, ${profile.title}`}>
<meta name="twitter:card" content="summary_large_image">

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<slot />
</body>
</html>
