---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/dm-sans/opsz.css';
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import { profile } from '../data/profile';

const canonical = new URL('/', profile.siteUrl).href;
const ogImage = new URL('/og.png', profile.siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.jobTitle,
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: profile.locality, addressRegion: profile.region, addressCountry: 'US' },
  worksFor: { '@type': 'Organization', name: profile.experience[0].company },
  ...((profile.linkedin || profile.github) ? { sameAs: [profile.linkedin, profile.github].filter(Boolean) } : {}),
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{profile.meta.title}</title>
<meta name="description" content={profile.meta.description}>
<meta name="theme-color" content="#0f1012">
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin>

<meta property="og:type" content="profile">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={profile.meta.title}>
<meta property="og:description" content={profile.meta.description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${profile.name}: ${profile.hero.headline[0]} ${profile.hero.headline[1]}${profile.hero.headline[2]}`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={profile.meta.title}>
<meta name="twitter:description" content={profile.meta.description}>
<meta name="twitter:image" content={ogImage}>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<slot />
<script>import '../scripts/site.ts';</script>
</body>
</html>
